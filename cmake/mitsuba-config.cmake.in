@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Pull in any dependencies mitsuba was built against so their imported
# targets exist before MitsubaTargets.cmake tries to reference them.
find_dependency(JPEG REQUIRED)
find_dependency(PNG REQUIRED)
find_dependency(TIFF REQUIRED)

if(@MI_EXTERNAL_OPENEXR@)
  find_dependency(OpenEXR REQUIRED)
else()
  # Bundled OpenEXR/IlmBase install their own cmake targets separately.
  find_dependency(IlmBase REQUIRED)
  find_dependency(OpenEXR REQUIRED)
endif()

if(@MI_EXTERNAL_PUGIXML@)
  find_dependency(pugixml REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MitsubaTargets.cmake")

check_required_components(mitsuba)
