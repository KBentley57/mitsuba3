@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Pull in any dependencies mitsuba was built against so their imported
# targets exist before MitsubaTargets.cmake tries to reference them.
find_dependency(JPEG REQUIRED)
find_dependency(PNG REQUIRED)
find_dependency(TIFF REQUIRED)

if(@MI_EXTERNAL_OPENEXR@)
  find_dependency(OpenEXR CONFIG QUIET)
  if(NOT TARGET OpenEXR::OpenEXR AND NOT TARGET OpenEXR::IlmImf)
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(PC_OpenEXR REQUIRED IMPORTED_TARGET OpenEXR)
  endif()
else()
  # Bundled OpenEXR/IlmBase install their own cmake targets separately.
  set(_mitsuba_old_prefer_config ${CMAKE_FIND_PACKAGE_PREFER_CONFIG})
  set(CMAKE_FIND_PACKAGE_PREFER_CONFIG TRUE)
  find_dependency(IlmBase CONFIG REQUIRED)
  find_dependency(OpenEXR CONFIG REQUIRED)
  set(CMAKE_FIND_PACKAGE_PREFER_CONFIG ${_mitsuba_old_prefer_config})
  unset(_mitsuba_old_prefer_config)
endif()

if(@MI_EXTERNAL_PUGIXML@)
  find_dependency(pugixml REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MitsubaTargets.cmake")

check_required_components(mitsuba)
